# ==============================================================================
# SoulTalk Environment Configuration Template
# ==============================================================================
# This file defines the template or placeholder variables used by the Secrets
# Gradle Plugin, the FastAPI backend, and the PostgreSQL database.
#
# Duplicate this file to '.env' for local development. Do NOT commit the actual
# '.env' file containing real credentials or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM CONFIGURATION
# ------------------------------------------------------------------------------
# Required for Gemini AI API calls. Configure this via the Secrets panel in AI Studio.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ------------------------------------------------------------------------------
# 2. FASTAPI BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# The base URL where the FastAPI backend server is hosting.
# In the Android Emulator, 'http://10.0.2.2:8000/' maps directly to 'localhost:8000' on your host machine.
BACKEND_BASE_URL=http://10.0.2.2:8000/

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONNECTION SETUP
# ------------------------------------------------------------------------------
# The direct connection URI or credentials for connecting FastAPI to the PostgreSQL database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soultalk_db

# Individual credentials for flexible containerized/microservice orchestration setups
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=soultalk_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
