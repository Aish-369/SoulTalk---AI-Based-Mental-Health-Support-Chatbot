# SoulTalk Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
# For Neon PostgreSQL, use the pooled connection URL for production
# Format: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL=postgresql://your_username:your_password@your-neon-host.neon.tech/neondb?sslmode=require

# Alternative: Use direct connection for testing (not recommended for production)
# DATABASE_URL=postgres://your_username:your_password@your-neon-host.neon.tech/neondb?sslmode=require

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# CORS Configuration (comma-separated origins for production)
ALLOWED_ORIGINS=https://soultalk.com,https://app.soultalk.com

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Environment
ENVIRONMENT=development  # development, staging, production

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
